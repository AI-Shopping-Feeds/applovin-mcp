# Copy to .env (gitignored) or ~/.applovin-mcp/.env and fill in. Never commit real values.
# `applovin-mcp setup` stores keys in ~/.applovin-mcp/secrets/keys.json (0600) instead;
# environment variables win over that file. You only need the side you use.

# --- Ads Manager (advertisers) ---
# Campaign Management API key (account menu > Keys; Admins only; whitelist-only beta)
APPLOVIN_CAMPAIGN_MANAGEMENT_API_KEY=
# Account ID (account menu > Go to settings; the number after the account name)
APPLOVIN_ACCOUNT_ID=
# Report Key (account menu > Keys)
APPLOVIN_REPORTING_API_KEY=
# app (default) or web: which report applovin_ads_report uses by default
APPLOVIN_ADS_ACCOUNT_TYPE=app

# --- MAX (publishers): MAX dashboard > Account > General > Keys ---
APPLOVIN_MAX_REPORT_KEY=
APPLOVIN_MAX_MANAGEMENT_KEY=
# Only for Ad Review rules
APPLOVIN_AD_REVIEW_KEY=

# --- Optional ---
# Where `applovin-mcp setup` saves keys (default ~/.applovin-mcp/secrets/keys.json)
APPLOVIN_KEYS_FILE=
# The only folder creative files may be uploaded from (uploads are off without it)
APPLOVIN_UPLOAD_DIR=

# Start in dry-run: writes are recorded and previewed but NOT sent to AppLovin.
APPLOVIN_DRY_RUN=true
# Register only read-only tools (APPLOVIN_READONLY also works).
APPLOVIN_READ_ONLY=false
# Only some tool groups: ads, max, or e.g. ads_reporting,max_reporting,request
APPLOVIN_TOOL_GROUPS=

# Safety limits: writes beyond these need confirm='APPLY'.
APPLOVIN_BULK_THRESHOLD=10
APPLOVIN_MAX_INCREASE_PCT=20
# Optional caps in US dollars (blank = no cap).
APPLOVIN_MAX_DAILY_BUDGET=
APPLOVIN_MAX_CPM=

# Audit log of writes (default ~/.applovin-mcp/logs/audit.jsonl) and days to keep (0 = forever).
APPLOVIN_AUDIT_LOG=
APPLOVIN_AUDIT_RETENTION_DAYS=30

# Largest response or report file held in memory, in MB.
APPLOVIN_MAX_DOWNLOAD_MB=200
APPLOVIN_PAGE_SIZE=100
APPLOVIN_REPORT_PAGE_SIZE=5000
APPLOVIN_TIMEOUT=60
APPLOVIN_LOG_LEVEL=INFO

# Transport: stdio (Claude Code / Desktop) or streamable-http (served at /mcp).
APPLOVIN_TRANSPORT=stdio
APPLOVIN_HOST=127.0.0.1
APPLOVIN_PORT=8000
# Allow HTTP on a non-loopback address. The server has no sign-in: leave false.
APPLOVIN_ALLOW_REMOTE=false
